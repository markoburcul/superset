msgid ""
"This can be either an IP address (e.g. 127.0.0.1) or a domain name (e.g. "
"mydatabase.com)."
msgstr ""
"Ovo može biti ili IP adresa (npr. 127.0.0.1) ili naziv domene (npr. "
"mydatabase.com)."

msgid ""
"This chart applies cross-filters to charts whose datasets contain columns "
"with the same name."
msgstr ""
"Ovaj grafikon primjenjuje križne filtre na grafikone čiji skupovi podataka "
"sadrže stupce s istim imenom."

msgid "This chart has been moved to a different filter scope."
msgstr "Ovaj grafikon je premješten u drugi opseg filtra."

msgid "This chart is managed externally, and can't be edited in Superset"
msgstr "Ovaj grafikon se upravlja izvana i ne može se uređivati u Supersetu."

msgid ""
"This chart might be incompatible with the filter (datasets don't match)"
msgstr ""
"Ovaj grafikon možda nije kompatibilan s filtrom (skupovi podataka se ne "
